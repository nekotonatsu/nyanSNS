# Database
POSTGRES_USER=nyan_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=nyan_sns
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production

# Backend
SECRET_KEY=change_me_to_random_64_char_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_SECONDS=300

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# MinIO (Object Storage)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=nyan-media
MINIO_USE_SSL=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Score thresholds
SCORE_INITIAL=100
SCORE_HIDDEN_THRESHOLD=0
SCORE_PRIORITY_THRESHOLD=200

# Environment
ENVIRONMENT=development
